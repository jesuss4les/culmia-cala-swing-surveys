<script>
var SHEET_URL='https://script.google.com/macros/s/AKfycbxWUBLnMC6z8fHBRshc5j5X0IRvvUk43ttgFklzaSE0YMrHwB9Z9GrVKWn9G21LLxYZwg/exec';
var TOKEN='', lang='en', top3Count=0;

window.addEventListener('load',function(){
  var p=new URLSearchParams(window.location.search);
  TOKEN=p.get('token')||'';
  if(!TOKEN){showDenied('no_token');return;}
  fetch(SHEET_URL+'?token='+TOKEN+'&survey=buyers_v2')
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.valid){
        document.getElementById('access-screen').style.display='none';
        document.getElementById('main-content').style.display='block';
        if(d.name) document.getElementById('fname').value=d.name;
        if(d.email) document.getElementById('femail').value=d.email;
        updateProgress();
      } else showDenied(d.reason);
    }).catch(function(){showDenied('error');});
});

function showDenied(r){
  var m={no_token:{t:'Access required',s:'Please use your personalised link sent by the Culmia team.'},not_found:{t:'Invalid link',s:'This link is not recognised. Please contact the Culmia sales team.'},already_used:{t:'Already submitted',s:'This link has already been used. Thank you for your participation.'},error:{t:'Connection error',s:'Please try again in a few moments.'}};
  var msg=m[r]||m.error;
  document.getElementById('access-title').textContent=msg.t;
  document.getElementById('access-msg').textContent=msg.s;
  document.getElementById('access-screen').style.display='flex';
}

function setLang(l,btn){
  lang=l;
  document.querySelectorAll('.lang-btn').forEach(function(b){b.classList.remove('active');});
  btn.classList.add('active');
  document.querySelectorAll('[data-'+l+']').forEach(function(el){
    var v=el.getAttribute('data-'+l);
    if(v) el.textContent=v;
  });
  updateTop3Counter();
  var ph={en:{fname:'e.g. James Wilson',femail:'e.g. james@email.com',q4:'e.g. A padel court, a sauna, a heated pool...'},es:{fname:'ej. Carlos García',femail:'ej. carlos@email.com',q4:'ej. Una pista de pádel, una sauna, una piscina climatizada...'}};
  ['fname','femail','q4'].forEach(function(id){var el=document.getElementById(id);if(el)el.placeholder=ph[l][id];});
}

function tog(el){el.classList.toggle('selected');updateProgress();}

function toggleMax(el,groupId,max,counterId){
  var grp=document.getElementById(groupId);
  var sel=grp.querySelectorAll('.selected').length;
  if(el.classList.contains('selected')){el.classList.remove('selected');}
  else{if(sel>=max){flash(counterId);return;}el.classList.add('selected');}
  var c=document.getElementById(counterId);
  var now=grp.querySelectorAll('.selected').length;
  c.textContent=now+' / '+max+' '+(lang==='en'?'selected':'seleccionados');
  c.style.color=now===max?'#018080':'#888';
  updateProgress();
}

function flash(id){
  var c=document.getElementById(id);
  c.style.color='#b45309';
  setTimeout(function(){c.style.color=top3Count===3?'#018080':'#888';},1500);
}

function selRadio(el,grp){
  document.querySelectorAll('#'+grp+' .radio-opt').forEach(function(b){b.classList.remove('selected');});
  el.classList.add('selected');
  updateProgress();
}

function showEl(id,show){document.getElementById(id).style.display=show?'block':'none';}

function togTop3(el){
  if(el.classList.contains('selected')){
    el.classList.remove('selected');
    el.querySelector('.chip-num').textContent='';
    top3Count--;
    reorderTop3();
  } else {
    if(top3Count>=3){flash('top3count');return;}
    top3Count++;
    el.classList.add('selected');
    el.querySelector('.chip-num').textContent=top3Count;
  }
  updateTop3Counter();
  updateProgress();
}

function reorderTop3(){
  top3Count=0;
  document.querySelectorAll('#top3 .chip.selected').forEach(function(c){
    top3Count++;
    c.querySelector('.chip-num').textContent=top3Count;
  });
}

function updateTop3Counter(){
  var c=document.getElementById('top3count');
  c.textContent=top3Count+' / 3 '+(lang==='en'?'selected':'seleccionados');
  c.style.color=top3Count===3?'#018080':'#668';
  c.className='counter'+(top3Count===3?' done':'');
}

function getSelected(id){
  var names=[];
  document.querySelectorAll('#'+id+' .selected').forEach(function(el){
    var s=el.querySelector('span')||el.querySelector('.opt-name');
    if(s) names.push(s.textContent.trim());
  });
  return names.join(' | ');
}

function getTop3(){
  var items=[];
  document.querySelectorAll('#top3 .chip.selected').forEach(function(c){
    items.push(c.querySelector('.chip-num').textContent+'. '+c.querySelector('span').textContent.trim());
  });
  return items.join(' | ');
}

function getRadio(id){
  var s=document.querySelector('#'+id+' .radio-opt.selected span');
  return s?s.textContent.trim():'';
}

function collectData(){
  return {
    Timestamp: new Date().toISOString(),
    Survey: 'Buyers_V2',
    Name: document.getElementById('fname').value.trim(),
    Email: document.getElementById('femail').value.trim(),
    Buyer_Type: getRadio('buyer-type'),
    Q1_Initial_Interest: getSelected('q1'),
    Q2_Wellness: getSelected('s-wellness'),
    Q2_Experience: getSelected('s-exp'),
    Q2_Social: getSelected('s-social'),
    Has_Pet: getRadio('has-pet'),
    Q2_PetStation: getSelected('s-pet'),
    Q2_Leisure: getSelected('s-leisure'),
    Q2_Practical: getSelected('s-practical'),
    Q2_Aspirational: getSelected('s-asp'),
    Q3_Residential_Experience: getSelected('q3'),
    Q4_Suggestion: document.getElementById('q4').value.trim(),
    Top3: getTop3(),
    token: TOKEN,
    survey: 'buyers_v2'
  };
}

function updateProgress(){
  var f=0;
  if(document.getElementById('fname').value.trim()) f++;
  if(document.getElementById('femail').value.trim()) f++;
  if(document.querySelectorAll('#buyer-type .selected').length>0) f++;
  if(document.querySelectorAll('#q1 .selected').length>0) f++;
  ['s-wellness','s-exp','s-social','s-leisure','s-practical','s-asp','q3'].forEach(function(id){
    if(document.querySelectorAll('#'+id+' .selected').length>0) f++;
  });
  if(top3Count>0) f++;
  var pct=Math.round((f/12)*100);
  document.getElementById('pfill').style.width=pct+'%';
  document.getElementById('pct').textContent=pct+'%';
}

function submitSurvey(){
  var name=document.getElementById('fname').value.trim();
  var email=document.getElementById('femail').value.trim();
  var type=document.querySelectorAll('#buyer-type .selected').length>0;
  var ok=true;
  function se(id,show){document.getElementById(id).style.display=show?'block':'none';}
  if(!name){se('err-name',true);ok=false;}else se('err-name',false);
  if(!email||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){se('err-email',true);ok=false;}else se('err-email',false);
  if(!type){se('err-type',true);ok=false;}else se('err-type',false);
  if(!ok){document.getElementById('err-name').scrollIntoView({behavior:'smooth',block:'center'});return;}

  var btn=document.getElementById('submitBtn');
  btn.textContent='Sending...';btn.disabled=true;

  var payload=collectData();
  var iframe=document.createElement('iframe');
  iframe.name='hf';iframe.style.display='none';
  document.body.appendChild(iframe);
  var form=document.createElement('form');
  form.method='POST';form.action=SHEET_URL;form.target='hf';form.style.display='none';
  var inp=document.createElement('input');
  inp.type='hidden';inp.name='payload';inp.value=JSON.stringify(payload);
  form.appendChild(inp);document.body.appendChild(form);
  setTimeout(function(){
    document.getElementById('form-body').style.display='none';
    document.getElementById('thankyou').style.display='block';
    window.scrollTo({top:0,behavior:'smooth'});
  },2000);
  form.submit();
}
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Culmia Cala Swing – Your Experience</title>
<style>
:root{--c-dark:#00272c;--c-teal:#018080;--c-light:#dfe9ec;--c-white:#ffffff}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;background:#dfe9ec;color:#00272c;font-size:15px}
.wrap{max-width:720px;margin:0 auto;padding:2rem 1rem 4rem}
.hero{border-radius:16px;overflow:hidden;margin-bottom:1.5rem;position:relative;background:#00272c}
.hero-bg{width:100%;height:250px;object-fit:cover;display:block;opacity:.4}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,39,44,.2),rgba(0,39,44,.85))}
.hero-content{position:absolute;bottom:0;left:0;right:0;padding:1.75rem 2rem}
.hero-badge{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;background:rgba(1,128,128,.35);border:1px solid rgba(1,128,128,.6);border-radius:20px;padding:4px 14px;display:inline-block;margin-bottom:.6rem;color:#dfe9ec}
.hero p{font-size:13px;color:rgba(223,233,236,.82);line-height:1.65;max-width:560px;margin-top:.4rem}
.feat-wrap{display:flex;flex-wrap:wrap;gap:6px;margin-top:.85rem}
.feat-tag{background:rgba(1,128,128,.25);border:1px solid rgba(1,128,128,.45);border-radius:20px;padding:3px 12px;font-size:11px;color:#dfe9ec}
.progress-wrap{margin-bottom:1.5rem}
.progress-label{font-size:12px;color:#00272c;margin-bottom:6px;display:flex;justify-content:space-between;font-weight:600}
.progress-bar{height:5px;background:#b0c8cc;border-radius:3px;overflow:hidden}
.progress-fill{height:100%;background:#018080;border-radius:3px;transition:width .4s}
.card{background:#fff;border:1px solid #c4d8dc;border-radius:14px;padding:1.5rem;margin-bottom:1rem}
.sec-label{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#018080;margin-bottom:.2rem}
.sec-title{font-size:17px;font-weight:700;color:#00272c;margin-bottom:.25rem}
.sec-sub{font-size:13px;color:#456;line-height:1.6;margin-bottom:1rem}
.field-label{font-size:13px;font-weight:700;color:#00272c;margin-bottom:5px;display:block}
input[type=text],input[type=email],textarea{width:100%;padding:10px 13px;border:1.5px solid #c4d8dc;border-radius:9px;font-size:14px;outline:none;transition:border .15s;margin-bottom:12px;background:#fff;color:#00272c;font-family:Arial,Helvetica,sans-serif}
input[type=text]:focus,input[type=email]:focus,textarea:focus{border-color:#018080}
textarea{resize:vertical;min-height:90px}
/* CHECKBOX OPTIONS */
.opts-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:9px}
.opts-grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:9px}
.opt{border:1.5px solid #c4d8dc;border-radius:11px;overflow:hidden;cursor:pointer;transition:all .15s;background:#fff}
.opt:hover{border-color:#018080}
.opt.selected{border:2px solid #018080;background:#f0f9f9}
.opt-img{width:100%;height:100px;object-fit:cover;display:block}
.opt-img-ph{width:100%;height:100px;display:flex;align-items:center;justify-content:center;font-size:24px;background:#dfe9ec}
.opt-body{padding:9px 12px 11px;display:flex;align-items:flex-start;gap:9px}
.chk{width:18px;height:18px;border-radius:5px;border:1.5px solid #b0c8cc;flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.opt.selected .chk{background:#018080;border-color:#018080}
.tick{display:none;width:5px;height:9px;border:2px solid #fff;border-top:none;border-left:none;transform:rotate(45deg) translateY(-1px)}
.opt.selected .tick{display:block}
.opt-name{font-size:13px;font-weight:700;color:#00272c;margin-bottom:2px}
.opt-desc{font-size:11px;color:#668;line-height:1.4}
/* SIMPLE CHECKBOX (no image) */
.chk-list{display:flex;flex-direction:column;gap:7px}
.chk-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1.5px solid #c4d8dc;border-radius:9px;cursor:pointer;transition:all .15s;background:#fff;font-size:13px;color:#00272c}
.chk-item:hover{border-color:#018080}
.chk-item.selected{border:2px solid #018080;background:#f0f9f9;font-weight:600}
.chk-item .chk{flex-shrink:0}
.chk-item.selected .chk{background:#018080;border-color:#018080}
.chk-item.selected .tick{display:block}
/* RADIO */
.radio-group{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:1rem}
.radio-opt{flex:1;min-width:110px;padding:10px 14px;border:1.5px solid #c4d8dc;border-radius:9px;cursor:pointer;font-size:14px;font-weight:600;color:#456;text-align:center;background:#fff;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:8px}
.radio-opt:hover{border-color:#018080}
.radio-opt.selected{border:2px solid #018080;background:#f0f9f9;color:#018080}
.radio-dot{width:16px;height:16px;border-radius:50%;border:1.5px solid #b0c8cc;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .15s}
.radio-opt.selected .radio-dot{border-color:#018080}
.radio-dot-inner{width:8px;height:8px;border-radius:50%;background:#018080;display:none}
.radio-opt.selected .radio-dot-inner{display:block}
/* TOP 3 */
.top3-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:8px}
.chip{padding:9px 13px;border:1.5px solid #c4d8dc;border-radius:9px;background:#fff;cursor:pointer;font-size:13px;color:#00272c;display:flex;align-items:center;gap:9px;transition:all .15s}
.chip:hover{border-color:#018080}
.chip.selected{border:2px solid #018080;background:#f0f9f9;font-weight:700}
.chip-num{width:23px;height:23px;border-radius:50%;background:#dfe9ec;color:#668;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .15s}
.chip.selected .chip-num{background:#018080;color:#fff}
.counter{font-size:12px;color:#668;margin-top:8px}
.counter.done{color:#018080;font-weight:700}
/* SUBMIT */
.submit-btn{width:100%;padding:1rem;background:#018080;color:#fff;border:none;border-radius:11px;font-size:16px;font-weight:700;cursor:pointer;margin-top:.5rem;transition:background .15s}
.submit-btn:hover{background:#00272c}
.required{color:#c0392b;font-size:12px;margin-left:3px}
.err{color:#c0392b;font-size:12px;margin-top:-8px;margin-bottom:10px;display:none}
.hidden-sec{display:none}
.note-box{background:#f0f9f9;border:1px solid #80c8c8;border-radius:11px;padding:1rem 1.25rem;margin-bottom:1rem;font-size:13px;color:#00272c;line-height:1.65}
.max-note{font-size:11px;color:#888;margin-bottom:8px}
/* THANK YOU */
.thank-you{text-align:center;padding:3rem 1.5rem;background:#fff;border:1px solid #c4d8dc;border-radius:14px}
.ty-icon{width:62px;height:62px;border-radius:50%;background:#f0f9f9;border:2px solid #018080;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem}
.thank-you h2{font-size:22px;font-weight:700;color:#00272c;margin-bottom:.6rem}
.thank-you p{font-size:14px;color:#456;line-height:1.65}
/* LANG */
.lang-toggle{display:flex;justify-content:flex-end;gap:6px;margin-bottom:1rem}
.lang-btn{padding:4px 14px;border:1.5px solid #b0c8cc;border-radius:20px;background:#fff;font-size:12px;font-weight:700;cursor:pointer;color:#668;transition:all .15s}
.lang-btn.active{background:#018080;color:#fff;border-color:#018080}
.access-screen{display:none;position:fixed;inset:0;background:#dfe9ec;z-index:999;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:2rem}
</style>
</head>

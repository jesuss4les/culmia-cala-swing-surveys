function SectionTitle({children}) {
  return <h2 style={{fontSize:18,fontWeight:700,color:DARK,borderLeft:`4px solid ${TEAL}`,paddingLeft:12,margin:"2rem 0 1rem"}}>{children}</h2>;
}
function SubTitle({children}) {
  return <h3 style={{fontSize:14,fontWeight:700,color:TEAL,textTransform:"uppercase",letterSpacing:"0.07em",margin:"1.5rem 0 0.5rem"}}>{children}</h3>;
}
function Stat({label, value, pct, rank}) {
  return (
    <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"8px 12px",borderBottom:`1px solid ${LIGHT}`,fontSize:13}}>
      {rank && <span style={{width:24,height:24,borderRadius:"50%",background:TEAL,color:"#fff",display:"flex",alignItems:"center",justifyContent:"center",fontSize:11,fontWeight:700,marginRight:10,flexShrink:0}}>{rank}</span>}
      <span style={{flex:1,color:DARK}}>{label}</span>
      <span style={{fontWeight:700,color:TEAL,marginLeft:12}}>{value}</span>
      <span style={{color:"#668",fontSize:12,marginLeft:8,minWidth:45,textAlign:"right"}}>{pct}</span>
    </div>
  );
}
function InsightBox({children}) {
  return <div style={{background:"#f0f9f9",border:`1px solid ${TEAL3}`,borderRadius:10,padding:"12px 16px",fontSize:13,color:DARK,lineHeight:1.7,margin:"0.75rem 0"}}>{children}</div>;
}
function Tag({children, color=TEAL}) {
  return <span style={{display:"inline-block",background:color+"22",border:`1px solid ${color}55`,borderRadius:20,padding:"3px 12px",fontSize:11,fontWeight:700,color:color,margin:"2px 3px"}}>{children}</span>;
}

